# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI providers (configure any/all — lib/ai.js tries them in this order
#     and falls through automatically: Groq -> Gemini -> OpenRouter) ---
# Groq: console.groq.com — fastest, free, no card. Comma-separate multiple
#   keys ONLY if you legitimately hold more than one (see lib/keyRotation.js).
GROQ_API_KEY=your-groq-key
# Gemini: aistudio.google.com/apikey — free tier, good general quality
GEMINI_API_KEY=your-gemini-key
# OpenRouter: openrouter.ai/keys — aggregates many :free-suffixed models,
#   good last-resort fallback if Groq/Gemini are both rate-limited
OPENROUTER_API_KEY=your-openrouter-key

# --- Fact-checking (grounds AI Fact Check in real published fact-checks) ---
# Google Fact Check Tools API — free, official, searches the same
# ClaimReview database used by PolitiFact, Snopes, BOOM Live, Alt News, etc.
# Get a key at console.cloud.google.com -> enable "Fact Check Tools API" -> Credentials
GOOGLE_FACTCHECK_API_KEY=your-google-factcheck-key

# --- News sources (daily brief pulls from every one you configure — GDELT
#     needs no key at all and is always on as a baseline) ---
GNEWS_API_KEY=your-gnews-key                 # gnews.io — free tier
NEWSDATA_API_KEY=your-newsdata-key           # newsdata.io — free tier
CURRENTS_API_KEY=your-currents-key           # currentsapi.services — free tier
GUARDIAN_API_KEY=your-guardian-key           # open-platform.theguardian.com — free, generous

# --- Social / mention-volume sources (drive the Political Stock Market) ---
# Wikipedia Pageviews + GDELT need NO key at all — always on, zero setup.
# Mastodon needs no key either — just pick a public instance:
MASTODON_INSTANCE=mastodon.social
# Bluesky — free account + App Password (bsky.app -> Settings -> App Passwords).
# Approval is instant. Public feed reads need no auth at all; keyword search needs this login.
BLUESKY_IDENTIFIER=your-handle.bsky.social
BLUESKY_APP_PASSWORD=your-app-password
# Reddit — OPTIONAL. Free tier is real (100 req/min, non-commercial) but as of
# 2026 new developer app registrations require manual approval, 2-4 weeks.
# Skip this unless you already have an approved Reddit app.
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
# X (Twitter) — OPTIONAL, paid only. No free tier exists as of Feb 2026.
# Leave blank unless you've bought API credits at developer.x.com.
X_BEARER_TOKEN=

# --- Cron protection for /api/stock-refresh and /api/daily-brief ---
# Vercel sends this automatically as "Authorization: Bearer $CRON_SECRET"
# once you set it as an env var — see vercel.json.
CRON_SECRET=choose-a-random-string
